# PropectAI - variaveis de ambiente
# Copie para .env e ajuste. NUNCA versione o .env.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_VERSION=0.1.1
APP_NAME=PropectAI

# ---------------------------------------------------------------------------
# Portas
# As portas de banco e fila sao deslocadas de proposito (5434 em vez de 5432,
# 6381 em vez de 6379) para tornar impossivel conectar no Bellvia por engano.
# ---------------------------------------------------------------------------
WEB_PORT=3100
API_PORT=3101
POSTGRES_PORT=5434
REDIS_PORT=6381
SCRAPER_PORT=8081

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=propectai
POSTGRES_PASSWORD=propectai_dev_only
POSTGRES_DB=propectai
DATABASE_URL=postgresql://propectai:propectai_dev_only@localhost:5434/propectai?schema=public

# ---------------------------------------------------------------------------
# Redis / BullMQ
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6381

# ---------------------------------------------------------------------------
# Autenticacao
# Gere segredos proprios antes de qualquer uso fora do seu computador:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=troque-este-valor-antes-de-usar-fora-do-localhost
JWT_REFRESH_SECRET=troque-este-valor-tambem-e-use-um-diferente
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost

# ---------------------------------------------------------------------------
# Motor de coleta (gosom/google-maps-scraper)
# Em dev a API roda local e acessa o container pela porta publicada.
# Em producao a porta nao e publicada: usar http://propectai-gmaps-scraper:8080
# ---------------------------------------------------------------------------
SCRAPER_BASE_URL=http://localhost:8081
SCRAPER_TIMEOUT_SECONDS=300
SCRAPER_MAX_CONCURRENT_JOBS=2

# Provider de leads: mock | google-maps
# Manter em mock ate a Fase 4 estar validada.
LEAD_SOURCE_PROVIDER=mock

# ---------------------------------------------------------------------------
# Inteligencia artificial
#
# mock    deterministico, sem chave, sem custo. Padrao.
# gemini  geracao real. Exige GEMINI_API_KEY.
#
# Com AI_PROVIDER=gemini e chave ausente, o sistema cai no mock e AVISA em log.
# A queda nao e silenciosa de proposito: mensagens plausiveis porem genericas
# passam despercebidas ate alguem comparar a saida com o que esperava.
#
# O Gemini atende dois usos: abordagem por IA e geracao de termos de busca por
# idioma na taxonomia de segmentos.
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Front-end
# ---------------------------------------------------------------------------
# Usado pelo navegador.
NEXT_PUBLIC_API_URL=http://localhost:3101
# Usado pelos Server Components do Next. IPv4 explicito de proposito:
# o fetch do Node prefere ::1 ao resolver "localhost" no Windows.
API_INTERNAL_URL=http://127.0.0.1:3101
NEXT_PUBLIC_APP_VERSION=0.1.1
# Origem autorizada no CORS da API.
WEB_ORIGIN=http://localhost:3100

# ---------------------------------------------------------------------------
# Seed de demonstracao
# Dados ficticios. Nao usar e-mail ou telefone reais.
# ---------------------------------------------------------------------------
SEED_TENANT_NAME=Layart Agencia Digital
SEED_OWNER_EMAIL=owner@demo.propectai.local
SEED_OWNER_PASSWORD=Demo@123456
SEED_SDR_EMAIL=sdr@demo.propectai.local
SEED_SDR_PASSWORD=Demo@123456

# ---------------------------------------------------------------------------
# IA de abordagem
# Provider padrao e mock e nao exige chave. Os adapters externos existem como
# codigo documentado, mas nao sao ativados na v0.1.1.
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
