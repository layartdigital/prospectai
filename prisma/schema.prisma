// PropectAI - modelo de dados v0.1.1
// Referencia: docs/technical/data-model.md
//
// Principios:
//   1. Toda entidade de negocio carrega tenantId desde a primeira migration.
//   2. Indices unicos de negocio sao sempre compostos com tenantId.
//   3. Exclusao e logica (deletedAt). AuditLog nunca e alterado.
//   4. Entidades sem interface na v0.1.1 existem no schema para nao exigir
//      retrofit depois (Proposal, Contract, Tag, ExportJob).
//   5. O modulo "Construtor de Sites" nao existe - nenhuma tabela o representa.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum Role {
  OWNER
  ADMIN
  MANAGER
  SDR
  VIEWER
}

/// **Em remocao.** Mantido apenas enquanto `prisma/set-plan.ts` e as
/// assinaturas de metodo dos services migram para `string` — ver
/// `docs/strategic/lacunas-estruturais.md` §11.1, passos 4 e 5.
///
/// `Plan.code` deixou de usa-lo em 13/08/2026: plano precisa ser criado e
/// excluido pelo Master, e enum do Postgres torna isso migration. Mesmo
/// defeito da taxonomia de segmentos — informacao que muda por decisao
/// comercial vivendo compilada.
enum PlanCode {
  FREE
  START
  PRO
  AGENCY
}

/// Espelha os estados do Stripe de proposito.
///
/// Traduzir para um vocabulario proprio pareceria mais limpo e criaria a
/// pergunta impossivel de responder as tres da manha: "o cliente esta bloqueado
/// porque o nosso estado diz X ou porque o do Stripe diz Y?". Mesmo nome,
/// mesma coisa, uma verdade so.
///
/// `INCOMPLETE` e o checkout que comecou e nao terminou — existe porque o
/// Stripe cria a assinatura antes da confirmacao do pagamento, e sem este
/// estado ela apareceria como TRIALING para quem nunca pagou.
enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
}

enum ScrapeJobStatus {
  PENDING
  QUEUED
  RUNNING
  NORMALIZING
  SCORING
  COMPLETED
  FAILED
  CANCELLED
}

enum LeadSource {
  GOOGLE_MAPS
  CSV_IMPORT
  MANUAL
  MOCK
}

/// Tres estados, nunca dois. DESCONHECIDO significa "nao verificado" e nao
/// pontua no score. So vira AUSENTE apos verificacao real.
enum SignalState {
  PRESENTE
  AUSENTE
  DESCONHECIDO
}

/// SITE_PRECARIO = dominio de construtor gratuito, encurtador ou rede social
/// usada como site. E oportunidade comercial, nao "ja tem site".
enum WebsiteStatus {
  SEM_SITE
  SITE_PRECARIO
  SITE_PROPRIO
  DESCONHECIDO
}

/// LIKELY = telefone celular brasileiro. Nao houve verificacao externa.
/// O rotulo na interface e "WhatsApp provavel", nunca "Com WhatsApp".
enum WhatsAppStatus {
  UNKNOWN
  LIKELY
  VERIFIED
}

enum ScoreLevel {
  BAIXA
  MEDIA
  ALTA
  MUITO_ALTA
}

enum ScoreReasonPolarity {
  POSITIVE
  NEGATIVE
  DISQUALIFYING
}

enum ActivityType {
  LEAD_CREATED
  LEAD_UPDATED
  PHONE_COPIED
  MAP_OPENED
  WHATSAPP_OPENED
  WEBSITE_OPENED
  SOCIAL_OPENED
  STAGE_CHANGED
  FAVORITED
  UNFAVORITED
  SUPPRESSED
  SCORE_RECALCULATED
  OUTREACH_GENERATED
  CONTACT_REGISTERED
  FOLLOWUP_CREATED
  FOLLOWUP_COMPLETED
  NOTE_ADDED
}

enum ContactChannel {
  WHATSAPP
  EMAIL
  INSTAGRAM
  PHONE
  IN_PERSON
  OTHER
}

enum ContactDirection {
  SENT
  RECEIVED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  OVERDUE
  CANCELLED
}

enum FollowUpPriority {
  LOW
  MEDIUM
  HIGH
}

enum OutreachTone {
  CONSULTIVO
  DIRETO
  INFORMAL
  EXECUTIVO
}

enum NotificationType {
  HIGH_SCORE_LEAD
  SEARCH_COMPLETED
  SEARCH_FAILED
  FOLLOWUP_OVERDUE
  LIMIT_NEAR
  WEEKLY_SUMMARY
  LEAD_PROFILE_UPDATED
}

enum SuppressionReason {
  USER_REQUEST
  INVALID_DATA
  COMPETITOR
  ALREADY_CLIENT
  OTHER
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED
}

enum ExportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ===========================================================================
// IDENTIDADE E ACESSO
// ===========================================================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  memberships    Membership[]
  refreshTokens  RefreshToken[]
  platformAdmin  PlatformAdmin?
  invitationsSent Invitation[]      @relation("InvitationInviter")
  auditLogs      AuditLog[]
  activities     LeadActivity[]
  notes          LeadNote[]
  contactRecords LeadContactRecord[]
  followUps      LeadFollowUp[]      @relation("FollowUpOwner")
  ownedCards     PipelineCard[]
  outreach       OutreachMessage[]
  transitions    PipelineTransition[]

  @@index([email])
  @@map("users")
}

/// Tipo de cliente, para efeito fiscal.
///
/// Existe porque a venda B2B na Uniao Europeia aplica reverse charge — quem
/// recolhe o imposto e o comprador, desde que tenha numero fiscal valido. Na
/// venda a pessoa fisica nao ha essa saida, e boa parte dos paises cobra do
/// vendedor estrangeiro desde o primeiro euro, sem limiar.
///
/// Decisao de 06/08/2026: PF liberado no Brasil, `taxId` obrigatorio fora.
/// O campo existe para que abrir PF em outro pais depois seja mudanca de
/// regra de validacao, nao migration sobre dado ambiguo.
enum CustomerType {
  PF
  PJ
}

model Tenant {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  timezone  String    @default("America/Sao_Paulo")

  /// Pais da empresa cliente, ISO 3166-1 alpha-2.
  country String @default("BR")

  /// Moeda de cobranca, ISO 4217. Deixa a porta aberta para preco por regiao,
  /// que e pratica corrente em SaaS — plano unico convertido pela cotacao do
  /// dia trata Brasil e Suica como o mesmo mercado.
  currency String @default("BRL")

  /// Numero de identificacao fiscal: VAT na Europa, CNPJ no Brasil,
  /// equivalente em cada pais. Habilita reverse charge na venda B2B, e o
  /// Stripe Tax valida a partir dele.
  ///
  /// Nulo e valido: pessoa fisica brasileira nao precisa.
  taxId String?

  customerType CustomerType @default(PJ)

  /// Segmento de atuacao do cliente.
  ///
  /// Define os padroes de servico e nicho no onboarding. Opcional: quem nao se
  /// reconhece em nenhum dos 500 preenche na mao, e o produto continua
  /// funcionando — taxonomia e atalho, nao pedagio.
  segmentId String?
  segment   Segment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  /// Suspensao por inadimplencia ou abuso.
  ///
  /// Diferente de `deletedAt`: o dado permanece e o acesso para. O TenantGuard
  /// recusa tenant suspenso — sem isso, suspender seria apenas uma anotacao no
  /// painel, e inadimplente continuaria usando o produto normalmente.
  suspendedAt     DateTime?
  suspendedReason String?

  /// Cliente no provedor de pagamento.
  ///
  /// Fica no Tenant e nao na Subscription porque o cliente sobrevive ao
  /// contrato: quem cancela e volta seis meses depois tem o mesmo cartao, o
  /// mesmo historico de faturas e o mesmo dado fiscal. Criar um cliente novo
  /// a cada assinatura espalharia as faturas da mesma empresa por varios
  /// registros — e o dia em que alguem pedir a segunda via seria um problema.
  stripeCustomerId String? @unique

  isDemo    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships     Membership[]
  invitations     Invitation[]
  subscription    Subscription?
  planUsages      PlanUsage[]
  onboardingState OnboardingState?
  searches        ProspectingSearch[]
  scrapeJobs      ScrapeJob[]
  leads           Lead[]
  pipelineStages  PipelineStage[]
  pipelineCards   PipelineCard[]
  activities      LeadActivity[]
  notes           LeadNote[]
  contactRecords  LeadContactRecord[]
  followUps       LeadFollowUp[]
  outreach        OutreachMessage[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  suppressions    SuppressionEntry[]
  settings        AppSetting[]
  featureFlags    FeatureFlag[]
  proposals       Proposal[]
  contracts       Contract[]
  tags            Tag[]
  exportJobs      ExportJob[]

  @@map("tenants")
}

model Membership {
  id        String    @id @default(cuid())
  userId    String
  tenantId  String
  role      Role      @default(SDR)
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

/// Estagio de maturidade dos termos de busca de um locale.
enum SegmentLocaleStatus {
  /// Gerado por modelo, ainda nao verificado contra resultado real.
  GERADO
  /// Rodado no motor de coleta e devolveu resultado suficiente.
  VALIDADO
  /// Revisado por pessoa. Prevalece sobre os outros dois.
  CURADO
}

/// Segmento de atuacao de quem USA o produto.
///
/// Nao confundir com a categoria do lead, que descreve quem e prospectado e
/// vem do vocabulario do Google Places. Sao duas taxonomias com propositos
/// diferentes, e a ponte entre elas e `SegmentLocale.searchTerms`.
///
/// Ate 06/08/2026 esta informacao vivia como constante TypeScript com cinco
/// servicos de agencia digital. Taxonomia que altera o score — nicho vale +15 —
/// nao pode viver compilada: muda sem deploy, e precisa de versao.
///
/// A base de origem tem 500 segmentos e nao e verdade curada: e um ponto de
/// partida melhor que campo em branco. O tenant escolhe o segmento, recebe os
/// valores preenchidos e ajusta. Erro numa linha vira edicao de um cliente,
/// nao defeito de produto.
model Segment {
  id           String  @id @default(cuid())
  /// Identificador da base de origem, ex.: B2B-0001. Torna a reimportacao
  /// idempotente.
  externalId   String  @unique
  macroSegment String
  name         String
  specialty    String?

  /// Serviços que este segmento vende. Vira sugestao em Configuracoes.
  services      String[]
  /// Setores que este segmento atende. Vira sugestao de nicho prospectado.
  targetSectors String[]
  /// Sinais que indicam oportunidade. Alimenta o motor de score.
  opportunitySignals String[]

  painPoints    String?
  contractModel String?
  recurrence    String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locales SegmentLocale[]
  tenants Tenant[]

  @@index([macroSegment])
  @@index([isActive])
  @@map("segments")
}

/// Termos de busca de um segmento em um idioma e pais.
///
/// Existe porque a coluna de palavras-chave da base **e funcional, nao
/// textual**: ela vai literalmente ao scraper. "agencia de marketing digital
/// em Milano" nao devolve nada no Google Maps; o termo correto e "agenzia di
/// marketing digitale".
///
/// Traducao errada nao deixa a tela feia — deixa a busca vazia, e o cliente
/// conclui que o produto nao funciona no pais dele. Dai o `status`: termo
/// gerado por modelo so vira padrao depois de devolver resultado real.
model SegmentLocale {
  id        String @id @default(cuid())
  segmentId String
  /// BCP 47, ex.: pt-BR, it-IT.
  locale    String
  /// ISO 3166-1 alpha-2. Redundante com o locale de proposito: o mesmo idioma
  /// serve paises diferentes, e o termo util muda entre eles.
  country   String

  label       String
  searchTerms String[]

  status      SegmentLocaleStatus @default(GERADO)
  validatedAt DateTime?
  /// Quantos resultados o termo devolveu na validacao. Zero reprova.
  resultCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segment  Segment             @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  searches ProspectingSearch[]

  @@unique([segmentId, locale])
  @@index([country, status])
  @@map("segment_locales")
}

/// Operador da plataforma — quem administra o SaaS, nao um workspace.
///
/// Deliberadamente **fora** de `Membership` e de `Role`. Papel de membership e
/// escopado a um tenant; operador de plataforma enxerga todos por definicao.
/// Modelar isso como mais um papel colocaria o acesso irrestrito na mesma
/// estrutura que o TenantGuard percorre a cada requisicao — e bastaria um erro
/// de comparacao para vazar dado entre clientes.
///
/// Tabela separada, guarda separada, rota separada. A unica forma de virar
/// operador e um registro aqui, criado por script fora da aplicacao.
model PlatformAdmin {
  id        String   @id @default(cuid())
  userId    String   @unique
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_admins")
}

/// Convite para entrar num workspace.
///
/// Por que convite com token, e nao criacao direta de usuario com senha
/// definida pelo dono: senha escolhida por terceiro e senha que o dono
/// conhece. O convidado define a propria, e o dono nunca vê.
///
/// O token e guardado como hash, mesma politica do RefreshToken — vazamento
/// da tabela nao entrega acesso.
///
/// Nao ha envio de e-mail no produto. O link e mostrado a quem convidou, para
/// enviar pelo canal que preferir. Fingir que um e-mail saiu seria pior que
/// admitir que ele nao existe.
model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  role        Role      @default(SDR)
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([tenantId, acceptedAt, revokedAt])
  @@index([email])
  @@map("invitations")
}

/// Refresh token guardado como hash, nunca em claro. Rotaciona a cada uso.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ===========================================================================
// PLANOS E CONSUMO
// ===========================================================================

model Plan {
  id          String   @id @default(cuid())
  /// Identificador estavel do plano, em maiusculas: FREE, START, PRO, AGENCY.
  ///
  /// Texto e nao enum de proposito. O Master cria e desativa plano, e enum do
  /// Postgres transformaria cada plano novo em migration mais deploy — o que
  /// tornaria a tela de planos impossivel de escrever, nao apenas ausente.
  ///
  /// **E chave, nao rotulo.** O nome de vitrine vive em `name` e muda quando o
  /// marketing quiser; o `code` aparece em log, auditoria e integracao, e
  /// muda-lo quebra historico. Renomear plano nao toca aqui.
  code        String   @unique
  name        String
  description String?
  /// Preco de exibicao padrao. Vale para plano sem cobranca (gratuito, demo,
  /// seed) e como fallback quando `stripePriceId` e nulo.
  priceCents  Int      @default(0)
  currency    String   @default("BRL")

  /// Identificadores no provedor de pagamento.
  ///
  /// `stripePriceId` e o que vai ao checkout. Nenhum valor calculado por esta
  /// aplicacao e enviado ao Stripe — a aplicacao diz *qual* preco, nunca
  /// *quanto*. E o que faz cache desatualizado ser constrangimento visual em
  /// vez de cobranca errada.
  stripePriceId   String? @unique
  stripeProductId String?

  /// Cache dos `currency_options` do Price, em centavos: { "BRL": 14900 }.
  ///
  /// Sincronizado pelos webhooks `price.updated` e `product.updated`. Cache,
  /// nao verdade: divergiu, o valor cobrado continua sendo o do Stripe.
  pricesByCurrency Json @default("{}")
  /// Limites como JSON: leadsIncluded, searchesPerMonth, aiGenerationsPerMonth,
  /// maxUsers, exportFormats, retentionDays. Lido apenas pelo EntitlementService.
  limits      Json
  features    Json     @default("[]")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  cancelledAt        DateTime?

  /// Assinatura no provedor. Nulo em plano gratuito e no seed de demonstracao.
  stripeSubscriptionId String? @unique
  /// Moeda efetivamente cobrada, decidida no checkout. Fica aqui e nao no
  /// Tenant porque e propriedade do contrato, nao da empresa: trocar de plano
  /// pode trocar de moeda, e a fatura antiga continua valendo na moeda dela.
  currency             String  @default("BRL")
  /// Cancelamento agendado para o fim do periodo pago.
  ///
  /// Diferente de `cancelledAt`: aqui o cliente ja pediu para sair mas ainda
  /// tem acesso comprado. Tratar os dois como a mesma coisa cortaria acesso
  /// que foi pago.
  cancelAtPeriodEnd    Boolean @default(false)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("subscriptions")
}

/// reserved e settled ficam separados de proposito: a reserva acontece ao
/// iniciar o job, a liquidacao ao terminar com o numero real de leads novos.
/// Job que falha devolve a reserva. Lead duplicado nao consome cota.
model PlanUsage {
  id                  String   @id @default(cuid())
  tenantId            String
  periodStart         DateTime
  periodEnd           DateTime
  leadsReserved       Int      @default(0)
  leadsSettled        Int      @default(0)
  searchesCount       Int      @default(0)
  aiGenerationsCount  Int      @default(0)
  exportsCount        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart])
  @@index([tenantId])
  @@map("plan_usages")
}

/// Webhook recebido do provedor de pagamento.
///
/// **Existe para idempotencia, nao para historico.** O Stripe reentrega evento
/// quando a resposta demora ou falha, e reentrega o mesmo `id`. Processar
/// `invoice.paid` duas vezes creditaria cota duas vezes; processar
/// `subscription.deleted` fora de ordem suspenderia quem acabou de renovar.
/// A chave unica em `externalId` e o que torna reprocessar inofensivo.
///
/// **Sem `tenantId`, deliberadamente.** O evento chega antes de sabermos de
/// quem e — descobrir o tenant e parte do processamento, e evento de preco nem
/// pertence a tenant nenhum. Gravar primeiro e resolver depois e o que permite
/// responder 200 rapido: o Stripe considera lentidao como falha e reentrega.
///
/// `error` preenchido com `processedAt` nulo e a fila de conserto manual. Sem
/// isso, webhook que falha some, e o cliente que pagou fica sem acesso sem que
/// ninguem saiba.
model BillingEvent {
  id         String @id @default(cuid())
  provider   String @default("stripe")
  /// Id do evento no provedor, ex.: evt_1P... . E o que torna a entrega unica.
  externalId String
  type       String
  payload    Json

  processedAt DateTime?
  error       String?
  attempts    Int       @default(0)

  createdAt DateTime @default(now())

  @@unique([provider, externalId])
  @@index([type])
  @@index([processedAt])
  @@map("billing_events")
}

model OnboardingState {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  currentStep    Int       @default(1)
  servicesSold   Json      @default("[]")
  targetNiches   Json      @default("[]")
  targetRegions  Json      @default("[]")
  preferredChannel String?
  monthlyGoal    String?
  skipped        Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("onboarding_states")
}

// ===========================================================================
// PROSPECCAO
// ===========================================================================

model ProspectingSearch {
  id             String   @id @default(cuid())
  tenantId       String
  createdById    String?
  niche          String

  /// Pais da busca, ISO 3166-1 alpha-2. O termo enviado ao scraper precisa do
  /// pais para desambiguar: existe Sao Paulo no Brasil e San Paolo na Italia,
  /// e "Santiago" aparece em meia duzia deles.
  country        String   @default("BR")

  /// Termos sugeridos pela taxonomia, quando a busca usou um.
  ///
  /// Existe para validar o termo sem custo extra: a busca ja vai rodar, e o
  /// numero de resultados responde se o termo funciona naquele pais. Validar
  /// com scraper dedicado exigiria um job por termo, minutos por segmento, e
  /// consumiria capacidade que o cliente paga.
  ///
  /// O primeiro que usa um termo sugerido e cobaia — mas de uma busca que ele
  /// faria de qualquer jeito, e cujo resultado vazio ele resolve redigitando.
  segmentLocaleId String?
  segmentLocale   SegmentLocale? @relation(fields: [segmentLocaleId], references: [id], onDelete: SetNull)

  /// Regiao da busca. Sigla de UF no Brasil, nome da regiao fora dele —
  /// mesma convencao de Lead.addressStateUf, e o mesmo rename adiado.
  stateUf        String
  city           String
  neighborhood   String?
  radiusKm       Int      @default(10)
  requestedCount Int      @default(5)
  /// Filtros avancados: hasWebsite, noWebsite, hasPhone, hasEmail,
  /// minRating, minReviews, openOnly
  filters        Json     @default("{}")
  leadsFound     Int      @default(0)
  duplicatesFound Int     @default(0)
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobs   ScrapeJob[]
  leads  Lead[]

  @@index([tenantId, createdAt])
  @@map("prospecting_searches")
}

/// Uma busca pode gerar varios ScrapeJob: o scraper tem teto de 300 segundos
/// por job, entao buscas grandes sao fatiadas pelo worker.
model ScrapeJob {
  id             String          @id @default(cuid())
  tenantId       String
  searchId       String
  status         ScrapeJobStatus @default(PENDING)
  source         LeadSource      @default(GOOGLE_MAPS)
  idempotencyKey String
  externalJobId  String?
  queueJobId     String?
  keyword        String
  attempts       Int             @default(0)
  maxAttempts    Int             @default(3)
  resultCount    Int             @default(0)
  newLeadCount   Int             @default(0)
  duplicateCount Int             @default(0)
  errorCode      String?
  errorMessage   String?
  queuedAt       DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  search  ProspectingSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  records LeadSourceRecord[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([searchId])
  @@map("scrape_jobs")
}

// ===========================================================================
// LEADS
// ===========================================================================

model Lead {
  id       String  @id @default(cuid())
  tenantId String
  searchId String?

  name     String
  category String?

  phoneE164 String?
  phoneRaw  String?
  email     String?

  website       String?
  websiteStatus WebsiteStatus @default(DESCONHECIDO)

  /// Pais em ISO 3166-1 alpha-2. Default BR porque todo lead coletado ate
  /// 06/08/2026 veio do Brasil — a afirmacao e verdadeira para o dado
  /// existente, e por isso o default nao mente.
  ///
  /// Acrescentado em 06/08/2026, quando o alcance global virou requisito.
  /// Era o unico campo cujo custo crescia todo dia: sem ele, nao ha como
  /// descobrir retroativamente de que pais era cada lead.
  country String @default("BR")

  addressStreet       String?
  addressNeighborhood String?
  addressCity         String?
  /// Regiao administrativa: estado, provincia, condado.
  ///
  /// O nome do campo diz "StateUf" e a normalizacao converte via tabela de UF
  /// brasileira — correto enquanto o produto era so Brasil, mentiroso quando
  /// guardar "Lombardia". O rename para `addressRegion` foi adiado de
  /// proposito em 06/08/2026: sao 106 ocorrencias em 30 arquivos, e renomear
  /// nunca fica ambiguo, entao custa o mesmo depois. `country` nao tinha essa
  /// propriedade, e por isso entrou sozinho.
  ///
  /// Fora do Brasil, guarda o nome da regiao como veio da origem.
  addressStateUf      String?
  addressPostalCode   String?
  addressFull         String?
  latitude            Float?
  longitude           Float?

  reviewCount  Int?
  reviewRating Float?
  openHours    Json?
  timezone     String?

  source     LeadSource @default(GOOGLE_MAPS)
  placeId    String?
  cid        String?
  sourceUrl  String?
  /// sha256(nome normalizado + telefone E.164 + CEP). Deduplica leads sem placeId.
  fingerprint String

  isFavorite     Boolean   @default(false)
  isDisqualified Boolean   @default(false)
  suppressedAt   DateTime?
  lastContactedAt DateTime?
  lastEnrichedAt DateTime?
  isDemo         Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  search           ProspectingSearch?    @relation(fields: [searchId], references: [id], onDelete: SetNull)
  sourceRecord     LeadSourceRecord?
  digitalPresence  LeadDigitalPresence?
  score            LeadScore?
  pipelineCard     PipelineCard?
  activities       LeadActivity[]
  notes            LeadNote[]
  contactRecords   LeadContactRecord[]
  followUps        LeadFollowUp[]
  outreachMessages OutreachMessage[]
  tags             LeadTag[]
  proposals        Proposal[]

  @@unique([tenantId, fingerprint])
  @@unique([tenantId, placeId])
  @@index([tenantId, createdAt])
  @@index([tenantId, addressStateUf, addressCity])
  @@index([tenantId, websiteStatus])
  @@index([searchId])
  @@map("leads")
}

/// Payload bruto da fonte, ja higienizado. user_reviews, user_reviews_extended
/// e o link de perfil em owner sao DESCARTADOS antes da gravacao: sao dados
/// pessoais de terceiros sem finalidade comercial no produto.
model LeadSourceRecord {
  id          String     @id @default(cuid())
  tenantId    String
  leadId      String     @unique
  scrapeJobId String?
  source      LeadSource @default(GOOGLE_MAPS)
  sourceId    String?
  payload     Json
  collectedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())

  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scrapeJob ScrapeJob? @relation(fields: [scrapeJobId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([scrapeJobId])
  @@map("lead_source_records")
}

/// Na v0.1.1 hasInstagram e hasFacebook sao SEMPRE DESCONHECIDO: nao existe
/// enriquecimento de redes sociais. Nunca AUSENTE.
model LeadDigitalPresence {
  id             String         @id @default(cuid())
  tenantId       String
  leadId         String         @unique
  hasWebsite     SignalState    @default(DESCONHECIDO)
  hasEmail       SignalState    @default(DESCONHECIDO)
  hasPhone       SignalState    @default(DESCONHECIDO)
  hasInstagram   SignalState    @default(DESCONHECIDO)
  hasFacebook    SignalState    @default(DESCONHECIDO)
  hasReviews     SignalState    @default(DESCONHECIDO)
  whatsappStatus WhatsAppStatus @default(UNKNOWN)
  instagramUrl   String?
  facebookUrl    String?
  websiteHasHttps Boolean?
  lastCheckedAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("lead_digital_presences")
}

model LeadScore {
  id               String     @id @default(cuid())
  tenantId         String
  leadId           String     @unique
  value            Int        @default(0)
  level            ScoreLevel @default(BAIXA)
  algorithmVersion String     @default("score-v1")
  calculatedAt     DateTime   @default(now())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  lead    Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  reasons LeadScoreReason[]

  @@index([tenantId, value])
  @@map("lead_scores")
}

/// O numero sozinho nao e gravado. Cada peso aplicado gera um registro aqui.
/// evidence guarda o dado que embasou, para o usuario poder discordar
/// de forma produtiva.
model LeadScoreReason {
  id        String              @id @default(cuid())
  tenantId  String
  scoreId   String
  code      String
  label     String
  weight    Int
  polarity  ScoreReasonPolarity
  evidence  String?
  createdAt DateTime            @default(now())

  score LeadScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@index([scoreId])
  @@index([tenantId, code])
  @@map("lead_score_reasons")
}

// ===========================================================================
// PIPELINE
// ===========================================================================

model PipelineStage {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  slug       String
  order      Int
  color      String   @default("#2F6BFF")
  isTerminal Boolean  @default(false)
  isWon      Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cards       PipelineCard[]
  fromMoves   PipelineTransition[] @relation("FromStage")
  toMoves     PipelineTransition[] @relation("ToStage")

  @@unique([tenantId, slug])
  @@index([tenantId, order])
  @@map("pipeline_stages")
}

model PipelineCard {
  id             String    @id @default(cuid())
  tenantId       String
  leadId         String    @unique
  stageId        String
  ownerId        String?
  position       Int       @default(0)
  estimatedValue Int?
  lostReason     String?
  enteredStageAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead        Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage       PipelineStage        @relation(fields: [stageId], references: [id])
  owner       User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  transitions PipelineTransition[]

  @@index([tenantId, stageId, position])
  @@map("pipeline_cards")
}

model PipelineTransition {
  id          String   @id @default(cuid())
  tenantId    String
  cardId      String
  fromStageId String?
  toStageId   String
  changedById String?
  origin      String   @default("manual")
  reason      String?
  createdAt   DateTime @default(now())

  card      PipelineCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  fromStage PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id])
  toStage   PipelineStage  @relation("ToStage", fields: [toStageId], references: [id])
  changedBy User?          @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([cardId, createdAt])
  @@index([tenantId])
  @@map("pipeline_transitions")
}

// ===========================================================================
// ATIVIDADE COMERCIAL
// ===========================================================================

/// Trilha automatica. E a diferenca entre um CRM que registra e um que so
/// armazena: toda acao do usuario na ficha do lead gera um registro.
model LeadActivity {
  id        String       @id @default(cuid())
  tenantId  String
  leadId    String
  actorId   String?
  type      ActivityType
  metadata  Json         @default("{}")
  createdAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, leadId, createdAt])
  @@map("lead_activities")
}

/// Nunca sobrescrita. Correcao gera nota nova, nao edicao silenciosa.
model LeadNote {
  id        String    @id @default(cuid())
  tenantId  String
  leadId    String
  authorId  String?
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([tenantId, leadId, createdAt])
  @@map("lead_notes")
}

model LeadContactRecord {
  id           String           @id @default(cuid())
  tenantId     String
  leadId       String
  authorId     String?
  channel      ContactChannel
  direction    ContactDirection
  outcome      String?
  notes        String?
  outreachId   String?
  occurredAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  rectifiedById String?

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author   User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  outreach OutreachMessage? @relation(fields: [outreachId], references: [id], onDelete: SetNull)

  @@index([tenantId, leadId, occurredAt])
  @@map("lead_contact_records")
}

/// OVERDUE e calculado por job periodico contra o timezone do TENANT,
/// nao do servidor.
model LeadFollowUp {
  id          String           @id @default(cuid())
  tenantId    String
  leadId      String
  ownerId     String?
  channel     ContactChannel   @default(WHATSAPP)
  priority    FollowUpPriority @default(MEDIUM)
  status      FollowUpStatus   @default(PENDING)
  dueAt       DateTime
  notes       String?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner  User?  @relation("FollowUpOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, dueAt])
  @@index([leadId])
  @@map("lead_follow_ups")
}

/// Na v0.1.1 nenhuma mensagem e disparada automaticamente. O produto gera
/// rascunho, o humano envia.
model OutreachMessage {
  id           String         @id @default(cuid())
  tenantId     String
  leadId       String
  authorId     String?
  channel      ContactChannel @default(WHATSAPP)
  tone         OutreachTone   @default(CONSULTIVO)
  serviceOffered String?
  objective    String?
  callToAction String?
  extraNotes   String?
  prompt       String
  content      String
  provider     String         @default("mock")
  model        String?
  tokensEstimated Int?
  version      Int            @default(1)
  isSent       Boolean        @default(false)
  sentAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead           Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author         User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  contactRecords LeadContactRecord[]

  @@index([tenantId, leadId, createdAt])
  @@map("outreach_messages")
}

// ===========================================================================
// SISTEMA
// ===========================================================================

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String?
  type      NotificationType
  title     String
  body      String?
  payload   Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, readAt, createdAt])
  @@map("notifications")
}

/// Imutavel. Nunca sofre update nem delete.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SuppressionEntry {
  id        String            @id @default(cuid())
  tenantId  String
  phoneE164 String?
  email     String?
  domain    String?
  reason    SuppressionReason @default(USER_REQUEST)
  notes     String?
  createdAt DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, phoneE164])
  @@index([tenantId, email])
  @@map("suppression_entries")
}

/// Torna o score ajustavel sem deploy: pesos, faixas e a lista de dominios
/// de construtor gratuito vivem aqui.
model AppSetting {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("app_settings")
}

model FeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  enabled   Boolean  @default(false)
  payload   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("feature_flags")
}

// ===========================================================================
// SEM INTERFACE NA v0.1.1
// Modeladas agora porque relacionamento e caro de acrescentar depois.
// Sem rota, sem item de menu, sem tela. Interface na v0.2.
// ===========================================================================

model Proposal {
  id          String         @id @default(cuid())
  tenantId    String
  leadId      String?
  title       String
  status      ProposalStatus @default(DRAFT)
  totalCents  Int            @default(0)
  currency    String         @default("BRL")
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead      Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  items     ProposalItem[]
  contracts Contract[]

  @@index([tenantId, status])
  @@map("proposals")
}

model ProposalItem {
  id          String   @id @default(cuid())
  proposalId  String
  description String
  quantity    Int      @default(1)
  unitCents   Int      @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("proposal_items")
}

model Contract {
  id         String         @id @default(cuid())
  tenantId   String
  proposalId String?
  title      String
  status     ContractStatus @default(DRAFT)
  content    String?
  signedAt   DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("contracts")
}

model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  color     String   @default("#6B7A99")
  createdAt DateTime @default(now())

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  LeadTag[]

  @@unique([tenantId, name])
  @@map("tags")
}

model LeadTag {
  leadId    String
  tagId     String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@map("lead_tags")
}

model ExportJob {
  id           String       @id @default(cuid())
  tenantId     String
  requestedById String?
  format       String       @default("csv")
  status       ExportStatus @default(PENDING)
  filters      Json         @default("{}")
  rowCount     Int          @default(0)
  filePath     String?
  errorMessage String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("export_jobs")
}
